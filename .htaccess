# =====================================================================
# BlaineSide UCP — clean URLs
#
# Every page is reachable without its .html extension:
#   /login  /create  /verify  /reset  /reset-confirm  /welcome
#   /dashboard  /dashboard/bulletin
#
# The .html files stay exactly where they are on disk — nothing is
# renamed — so any old link that still points at /login.html keeps
# working and is redirected to the clean form.
# =====================================================================

# MultiViews would resolve /login to login.html by content negotiation
# before the rules below run, which makes the HTTPS redirect target the
# .html name and costs an extra hop. The explicit rules handle this.
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

RewriteEngine On
RewriteBase /

# ---------------------------------------------------------------------
# 0. Force HTTPS.
#
#    This runs before everything else, including the API. People type
#    passwords into these pages, so they must never travel in the clear.
#
#    It also removes a whole class of session bug: cookies are marked
#    Secure when the connection is HTTPS, and a browser on plain HTTP
#    silently discards those — no session, no remember-me, straight back
#    to the login screen. With every request on HTTPS, that can't happen.
#
#    OVH terminates TLS at its edge, so the visitor's real scheme arrives
#    in X-Forwarded-Proto; %{HTTPS} describes the edge's own connection
#    and can't be trusted here. After the redirect the header reads
#    "https", so this never loops.
#
#    If HTTPS is ever unavailable on the domain, comment these four lines
#    out or the site will redirect endlessly.
# ---------------------------------------------------------------------
RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC,OR]
RewriteCond %{HTTP:X-Forwarded-Proto} ^$
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------------------
# Leave the API completely alone. It has its own .htaccess.
# ---------------------------------------------------------------------
RewriteRule ^api/ - [L]

# ---------------------------------------------------------------------
# 1. Old .html links -> canonical clean URL (301).
#
#    These match on THE_REQUEST — the literal request line the browser
#    sent — NOT on the current rewritten path. That distinction matters:
#    after rule 2 below rewrites /login to login.html internally, Apache
#    runs this whole file again with the new path. Matching on the path
#    would re-fire the 301, sending the browser back to /login, which
#    rewrites to login.html again — an infinite redirect loop.
#    THE_REQUEST never changes during internal rewrites, so these rules
#    fire only when someone genuinely typed a .html URL.
# ---------------------------------------------------------------------

# /index.html -> /   and   /dashboard/index.html -> /dashboard/
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /login.html -> /login   and   /dashboard.html -> /dashboard
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /dashboard/store.php -> /dashboard/store
# Same rule for the pages that are now PHP, so there is still exactly one
# canonical URL for every page. api/ is already excluded above.
RewriteCond %{THE_REQUEST} \s/+(.*?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ---------------------------------------------------------------------
# 2. Clean URL -> the real file.
#    /login          -> login.html             (file)
#    /dashboard      -> dashboard/index.html   (directory)
#
#    Both are internal rewrites, so the address bar keeps the clean URL.
# ---------------------------------------------------------------------

# DirectorySlash would otherwise bounce /dashboard -> /dashboard/ first.
DirectorySlash Off

# A path that already resolves to a real file is served as-is. This is
# what stops the rewrite loop: on the second pass login.html exists, so
# nothing below matches and rewriting ends.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -l
RewriteRule ^ - [L]

# /store -> store.php   (tried BEFORE .html)
#
# Pages that pull their sidebar and top bar from partials/ are .php. The
# .php rule comes first so a page that has been converted wins over an
# old .html left beside it — which makes the conversion reversible: delete
# the .php and the .html serves again, unchanged.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# /login -> login.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# /dashboard (or /dashboard/) -> dashboard/index.php, else index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.php -f
RewriteRule ^(.+?)/?$ $1/index.php [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# ---------------------------------------------------------------------
# 3. "/" serves the sign-in page.
# ---------------------------------------------------------------------
DirectoryIndex index.php index.html

# ---------------------------------------------------------------------
# Housekeeping
#
# Options is wrapped because a few shared hosts disallow it in .htaccess
# and would return 500 for the whole site rather than ignoring the line.
# ---------------------------------------------------------------------
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Repo files that get deployed alongside the site but should not be
# downloadable. migration.sql in particular hands out the full schema.
<FilesMatch "\.(sql|md|log|ini|sh|bak|old|dist|example)$">
  Require all denied
</FilesMatch>

# Nothing under docs/ is meant to be served.
RedirectMatch 404 ^/docs(/|$)

# Never serve the API's own includes or credentials, even if api/.htaccess
# goes missing during a deploy.
# The shell partials are includes, never pages. Blocked outright so
# /partials/shell-top.php cannot be fetched on its own.
RedirectMatch 404 ^/partials/

<FilesMatch "^(config\.php|config\.example\.php|_.*\.php)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # ---------------------------------------------------------------------
  # The shared front-end files revalidate on every visit.
  #
  # assets/js/ucp.js and assets/css/*.css are the sidebar, the bell, the
  # quick search, the clock and the build number — one copy for every page.
  # They used to be cache-busted with ?v=2.7.5 on a query string, which
  # meant changing one line of JavaScript was an edit to twelve HTML files,
  # and the twelfth was the one somebody forgot.
  #
  # no-cache does NOT mean "don't cache": the browser keeps the file and
  # asks whether it has changed, so the ordinary answer is a 304 with no
  # body. One conditional request per page load, and a deploy is live the
  # moment it lands.
  #
  # Images and fonts are not included — they are replaced by uploading a
  # new name, not by editing the old one.
  # ---------------------------------------------------------------------
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /login
